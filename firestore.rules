rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tasks: one document per match + item ("2026-10-10__dinde")
    match /assign/{id} {
      allow read: if true;
      allow delete: if true;
      allow write: if request.resource.data.keys().hasOnly(['m', 'k', 'who', 'done', 'when', 'slot', 'by'])
                   && request.resource.data.who is string && request.resource.data.who.size() < 40;
    }
    // Carpooling: one document per match + player ("2026-10-03__carles")
    match /rides/{id} {
      allow read: if true;
      allow delete: if true;
      allow write: if request.resource.data.keys().hasOnly(['m', 'who', 'role', 'seats', 'car'])
                   && request.resource.data.role in ['driver', 'passenger'];
    }
    // Matches added from the app: one document per match ("2027-05-08")
    match /matches/{id} {
      allow read: if true;
      allow delete: if true;
      allow write: if request.resource.data.keys().hasOnly(['date', 'home', 'opp', 'by'])
                   && request.resource.data.opp is string && request.resource.data.opp.size() > 0 && request.resource.data.opp.size() <= 40
                   && request.resource.data.home is bool
                   && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
